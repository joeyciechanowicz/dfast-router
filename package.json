{
  "name": "dfast-router",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "npm run typecheck && tsx --test test/*.test.* test/compiler/*.test.*",
    "test:consistency": "tsx test/router-consistency.test.mjs --full",
    "bench": "node bench/bench.mjs",
    "bench:static": "scripts/bench/run-static-bench.sh",
    "bench:compare": "node scripts/bench/compare.mjs",
    "profile:router": "node --prof scripts/profile-router.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeyciechanowicz/dfast-router.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/joeyciechanowicz/dfast-router/issues"
  },
  "homepage": "https://github.com/joeyciechanowicz/dfast-router#readme",
  "description": "HTTP router that compiles regex routes into one DFA.",
  "devDependencies": {
    "@koa/router": "^15.3.0",
    "@medley/router": "^0.2.1",
    "@tinyhttp/app": "^3.0.4",
    "@types/node": "^20.11.30",
    "express": "^5.3.0",
    "express-4": "npm:express@^4.22.3",
    "fastify": "^5.7.2",
    "find-my-way": "^8.2.0",
    "h3": "^1.15.0",
    "hono": "^4.11.7",
    "itty-router": "^5.0.22",
    "koa": "^3.1.1",
    "mitata": "^1.0.34",
    "path-to-regexp": "^8.3.0",
    "radix3": "^1.1.2",
    "trouter": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  }
}
